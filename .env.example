# Copy to .env.local and fill in from your Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, for testing from a phone or a preview link against a local Supabase:
# serve Supabase through the app on one port by using a path, plus the address the server uses.
# NEXT_PUBLIC_SUPABASE_URL=/sb
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
